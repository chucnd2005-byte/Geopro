datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN | STAFF
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int
  folder       String   @default("products") // products | banners | catalogs | articles
  altText      String?
  createdAt    DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   // Kỹ thuật RTK | Kinh nghiệm thực địa | Đánh giá thiết bị
  coverImage  String
  excerpt     String
  content     String
  author      String   @default("Kỹ sư GeoSurvey Pro")
  tags        String   // JSON array string
  isPublished Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  imageUrl     String
  targetUrl    String   @default("/products")
  badge        String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  parentId     String?
  icon         String?
  image        String?
  displayOrder Int        @default(0)
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Brand {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logo           String?
  country        String
  officialDealer Boolean   @default(true)
  warrantyPolicy String?
  products       Product[]
  createdAt      DateTime  @default(now())
}

model Product {
  id              String             @id @default(cuid())
  slug            String             @unique
  sku             String             @unique
  name            String
  brandId         String
  brand           Brand              @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category           @relation(fields: [categoryId], references: [id])
  basePrice       Float
  salePrice       Float?
  stock           Int                @default(10)
  condition       String             @default("NEW_100") // NEW_100 | REFURBISHED_99
  origin          String             // Thụy Sĩ, Nhật Bản, Trung Quốc, Mỹ
  warrantyMonths  Int                @default(24)
  isQuoteOnly     Boolean            @default(false)
  isFeatured      Boolean            @default(false)
  rating          Float              @default(5.0)
  reviewCount     Int                @default(0)
  mainImage       String
  gallery         String             // JSON string array of URLs
  shortDesc       String
  fullDesc        String
  highlights      String             // JSON string array of key spec bullet points
  standardPackage String             // JSON string array of items in hard case
  specs           ProductSpec?
  variants        ProductVariant[]
  downloads       TechnicalDownload[]
  quoteItems      QuoteItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ProductSpec {
  id                   String   @id @default(cuid())
  productId            String   @unique
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryType         String   // GNSS_RTK | TOTAL_STATION | OPTICAL_LEVEL | THEODOLITE | ACCESSORY
  
  // GNSS RTK Specs
  channels             Int?     // 1408, 1598, 800
  constellations       String?  // GPS, GLONASS, BDS, GALILEO, QZSS, NavIC
  horizontalAccuracy   String?  // 8mm + 1ppm RMS
  verticalAccuracy     String?  // 15mm + 1ppm RMS
  tiltCompensation     String?  // IMU 60° bù nghiêng tự động
  uhfPower             String?  // 1W/2W/4W phát xa 15km
  batteryLifeHours     Float?   // 15 hours
  weightKg             Float?   // 0.85 kg
  ingressProtection    String?  // IP67, IP68
  
  // Total Station Specs
  angularAccuracy      String?  // 1", 2", 5"
  reflectorlessRange   String?  // 1000m, 2000m
  prismRange           String?  // 5000m
  edmSpeed             String?  // 0.3s
  
  // Optical Level Specs
  magnification        String?  // 24x, 30x, 32x
  stdDevPerKm          String?  // 0.7mm/km, 1.5mm/km, 2.0mm/km
  
  // Detailed full specs JSON
  rawSpecs             String?  // Full JSON specification matrix
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String   @unique
  name            String   // e.g. "Bộ Rover Đơn (Gồm sổ tay)", "Trọn Bộ Base + Rover + Radio ngoài 35W"
  priceAdjustment Float    @default(0)
  stock           Int      @default(5)
  bundleIncludes  String?  // JSON string
}

model TechnicalDownload {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String   // e.g. "Catalog Thông Số Kỹ Thuật (PDF)", "Giấy Chứng Nhận Hiệu Chuẩn Quatest 1", "Sổ Tay Hướng Dẫn Đo RTK Tiếng Việt"
  docType     String   // CATALOG_PDF | CALIBRATION_CERT | USER_MANUAL | FIRMWARE
  fileUrl     String
  fileSize    String   // e.g. "4.8 MB"
  createdAt   DateTime @default(now())
}

model QuoteRequest {
  id              String      @id @default(cuid())
  quoteCode       String      @unique // e.g. BG-2026-0889
  companyName     String
  taxId           String?
  contactName     String
  phone           String
  email           String
  projectLocation String?
  projectScale    String?     // e.g. "Khảo sát tuyến đường cao tốc 45km", "Khảo sát trắc địa địa chính xã"
  notes           String?
  status          String      @default("PENDING") // PENDING | CONTACTED | QUOTED | WON | LOST
  items           QuoteItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteId        String
  quote          QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int          @default(1)
  requestedPrice Float?
}

model Order {
  id                  String      @id @default(cuid())
  orderCode           String      @unique // e.g. ORD-2026-9901
  customerName        String
  phone               String
  email               String
  address             String
  city                String
  note                String?
  subtotal            Float
  vatAmount           Float       @default(0)
  totalAmount         Float
  vatInvoiceRequested Boolean     @default(false)
  companyTaxId        String?
  companyName         String?
  companyAddress      String?
  paymentMethod       String      @default("BANK_TRANSFER") // BANK_TRANSFER | COD | ENTERPRISE_CREDIT
  status              String      @default("PENDING") // PENDING | PROCESSING | CALIBRATING | SHIPPED | COMPLETED | CANCELLED
  items               OrderItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  lineTotal Float
}

model Review {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName    String
  companyName   String?  // e.g. "Công ty CP Khảo sát & Xây dựng Miền Bắc"
  rating        Int      @default(5)
  title         String
  comment       String
  verifiedBuyer Boolean  @default(true)
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())
}

model SiteSettings {
  id                      String   @id @default("default_settings")
  // General Info
  siteName                String   @default("GeoSurvey Pro")
  slogan                  String   @default("Thiết Bị Trắc Địa & Đo Đạc Chính Hãng")
  metaDescription         String   @default("Hệ thống phân phối máy định vị GNSS RTK, máy toàn đạc điện tử, máy thủy bình tự động và phụ kiện trắc địa chính hãng tại Việt Nam.")
  lightLogoUrl            String?
  darkLogoUrl             String?
  faviconUrl              String?

  // Top Announcement Bar
  announcementActive      Boolean  @default(true)
  announcementMessage     String   @default("Miễn phí hiệu chuẩn & kiểm định thiết bị trắc địa toàn quốc (Trung tâm Vilas 110)")
  announcementButtonText  String?  @default("Đăng Ký Kiểm Định")
  announcementButtonUrl   String?  @default("/quote")

  // Header Navigation & CTA
  headerMenuJson          String   @default("[]") // Array of { id, label, url, is_dropdown, sub_items: [{ label, url }] }
  hotlineLabel            String   @default("Hotline Kỹ Thuật 24/7")
  hotlineNumber           String   @default("0988.355.688")
  quoteButtonText         String   @default("Nhận Báo Giá Dự Án")
  quoteButtonUrl          String   @default("/quote")

  // Company Legal & Contact Details
  legalBusinessName       String   @default("CÔNG TY CỔ PHẦN CÔNG NGHỆ TRẮC ĐỊA GEOPRO VIỆT NAM")
  taxCode                 String   @default("0109887766")
  businessLicense         String   @default("GPĐKKD số 0109887766 do Sở KH&ĐT TP.Hà Nội cấp ngày 15/03/2018")
  primaryEmail            String   @default("contact@geopro.vn")
  salesHotline            String   @default("0988.355.688")
  technicalSupportHotline String   @default("1900 8299")
  zaloNumber              String   @default("0988.355.688")

  // Showrooms List (JSON array string)
  showroomsJson           String   @default("[]") // Array of { id, branch_name, address, phone, google_maps_url }

  // Footer Configuration
  aboutText               String   @default("GeoSurvey Pro là đơn vị tiên phong cung cấp giải pháp đo đạc địa chính, trắc địa công trình và định vị vệ tinh độ chính xác cao hàng đầu Việt Nam. Đại lý ủy quyền chính thức của Leica Geosystems, Trimble, CHCNAV, Topcon.")
  footerColumnsJson       String   @default("[]") // 3 link columns: [{ title, links: [{ label, url }] }]
  trustBadgesJson         String   @default("[]") // Array of badge URLs or objects { title, imageUrl, linkUrl }
  socialFacebook          String?  @default("https://facebook.com/geopro.survey")
  socialZalo              String?  @default("https://zalo.me/0988355688")
  socialYoutube           String?  @default("https://youtube.com/@geoprosurvey")
  socialLinkedin          String?
  copyrightText           String   @default("© 2026 GEOPRO VIETNAM JSC. Tất cả quyền được bảo lưu. Giấy phép xuất bản thông tin số 24/GP-TTĐT.")

  updatedAt               DateTime @default(now()) @updatedAt
}

