# ==========================================
# GEOPRO E-COMMERCE & CMS ENVIRONMENT CONFIG
# ==========================================

# 1. Database (SQLite for local dev / PostgreSQL for Vercel production)
DATABASE_URL="file:./dev.db"

# 2. Admin Authentication (JWT 256-bit Secret)
ADMIN_JWT_SECRET="geosurvey_admin_jwt_secret_2026_super_secure_key_12345"

# 3. Cloudinary Cloud Storage (Serverless Vercel Media Uploads)
# Obtain these free credentials from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name_here"

# (Optional) Cloudinary Full Connection URL alternative
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
